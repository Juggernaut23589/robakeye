# ─────────────────────────────────────────────────────────────
# DATABASE (Supabase Postgres)
# DATABASE_URL = pooled connection (port 6543, pgbouncer mode) — used by
#                every runtime query from Vercel's serverless functions.
# DIRECT_URL   = direct connection (port 5432) — used ONLY by
#                `prisma migrate` / `prisma db push`, which need a real
#                session (pgbouncer transaction mode breaks migrations).
# Get both from Supabase dashboard → Project Settings → Database → Connection string.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# AUTH (NextAuth.js v5)
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="" # generate with: npx auth secret
NEXTAUTH_URL="http://localhost:3000" # production: https://robakeye.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────
# PAYMENTS (Paystack)
# ─────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# ─────────────────────────────────────────────────────────────
# FILE STORAGE (Cloudinary)
# The "robakeye-prescriptions" upload preset MUST be created with
# delivery type = "private" so prescription images are never
# publicly resolvable by URL guessing (NDPA 2023 compliance).
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_PRESCRIPTION_UPLOAD_PRESET="robakeye-prescriptions"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─────────────────────────────────────────────────────────────
# MAPS & LOCATION
# ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY="" # server-side (Distance Matrix)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="" # client-side (JS Maps, HTTP-referrer restricted)

# ─────────────────────────────────────────────────────────────
# SMS / WHATSAPP (Termii)
# ─────────────────────────────────────────────────────────────
TERMII_API_KEY=""
TERMII_SENDER_ID="Robakeye"

# ─────────────────────────────────────────────────────────────
# EMAIL (Resend)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Robakeye <orders@robakeye.com>"

# ─────────────────────────────────────────────────────────────
# REDIS (Upstash) — rate limiting, OTP throttling, distance-matrix cache
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────────────────────
# BACKGROUND JOBS (Inngest)
# Local dev: set INNGEST_DEV=1 (tells the SDK to run in dev mode with no
# keys), then run `npx inngest-cli@latest dev` in a second terminal — it
# discovers http://localhost:3000/api/inngest automatically.
# INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY are required ONLY in the deployed
# (Vercel) environment — never set INNGEST_DEV=1 there.
# ─────────────────────────────────────────────────────────────
INNGEST_DEV="1"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
